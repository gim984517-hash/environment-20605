  <script>
    // === 15. Sound Effects (Web Audio API) ===
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playSound(type) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      if (type === 'click') {
        osc.frequency.setValueAtTime(400, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(800, audioCtx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
        osc.start(); osc.stop(audioCtx.currentTime + 0.08);
      } else if (type === 'success') {
        osc.frequency.setValueAtTime(523.25, audioCtx.currentTime);
        osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.1);
        osc.frequency.setValueAtTime(783.99, audioCtx.currentTime + 0.2);
        gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.35);
        osc.start(); osc.stop(audioCtx.currentTime + 0.35);
      } else if (type === 'wipe') {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(150, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(400, audioCtx.currentTime + 0.3);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
        osc.start(); osc.stop(audioCtx.currentTime + 0.3);
      }
    }

    // === 2. 화면 전환 & Wipe 효과 ===
    let currentScreenId = 'screen-home';

    function triggerWipe(callback) {
      playSound('wipe');
      const overlay = document.getElementById('wipe-overlay');
      overlay.classList.remove('wipe-active');
      void overlay.offsetWidth; // Reflow
      overlay.classList.add('wipe-active');

      setTimeout(() => {
        if (callback) callback();
      }, 350); // 색상이 전체를 덮는 시점에 화면 전환
    }

    function showScreen(screenId) {
      document.querySelectorAll('.sub-screen').forEach(s => s.style.display = 'none');
      document.getElementById('screen-home').style.display = 'none';

      const target = document.getElementById(screenId);
