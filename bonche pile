    let modalTimer = null;
    function updateModalText(screenId) {
      const data = descriptions[screenId] || descriptions['screen-home'];
      document.getElementById('modalTitle').innerText = data.title;
      document.getElementById('modalBody').innerHTML = data.text;
      if (window.renderMathInElement) renderMathInElement(document.getElementById('modalBody'));
    }

    function openModal() {
      playSound('click');
      const overlay = document.getElementById('modalOverlay');
      overlay.style.display = 'flex';

      if (modalTimer) clearTimeout(modalTimer);
      modalTimer = setTimeout(() => { closeModal(); }, 10000); // 10초 후 자동 닫힘
    }

    function closeModal() {
      document.getElementById('modalOverlay').style.display = 'none';
      if (modalTimer) clearTimeout(modalTimer);
    }

    // === 3. Screen 1: 대기환경 인터랙션 ===
    const activeAirPolicies = new Set();
    function toggleAirPolicy(id) {
      playSound('click');
      const btn = document.getElementById(`btn-air-${id}`);
      if (activeAirPolicies.has(id)) {
        activeAirPolicies.delete(id);
        btn.classList.remove('active');
      } else {
        activeAirPolicies.add(id);
        btn.classList.add('active');
      }
      updateAirChart();
    }

    function updateAirChart() {
      const slider = document.getElementById('yearSlider');
      const year = parseInt(slider.value);
      document.getElementById('yearDisplay').innerText = year;

      const policyCount = activeAirPolicies.size;
      const dustBar = document.getElementById('dustBar');

      // 3개 정책 모두 적용 + 2025년 최우측일 때 최대 절반 약간 아래(45%)까지 감축
      const progressRatio = (year - 2000) / 25.0; // 0.0 ~ 1.0
      const maxReduction = policyCount * 0.183; // 정책 3개 시 약 55% 감축 가능
      const currentReduction = maxReduction * progressRatio;

      const finalHeightPercent = 100 - (currentReduction * 100);
      dustBar.style.height = `${finalHeightPercent}%`;

      if (policyCount === 3 && year === 2025) {
        playSound('success');
      }
    }

    // === 4. Screen 2: 태화강 인터랙션 ===
    let isPlantGrown = false, isPipeStopped = false, sludgeLeft = 4;
    function growPlants() {
      playSound('click');
      if (isPlantGrown) return;
      const p = document.getElementById('plants');
      p.innerText = '🌿🌿🌿🌿🌿';
      p.style.transform = 'scale(1.8) translateY(-15px)';
      isPlantGrown = true;
      checkRiverClear();
    }

    function stopWaste() {
      playSound('click');
      if (isPipeStopped) return;
      document.getElementById('wasteWater').style.display = 'none';
      isPipeStopped = true;
      checkRiverClear();
    }

    function removeSludge(el) {
      playSound('click');
      if (el.style.opacity === '0') return;
      el.style.opacity = '0';
      el.style.pointerEvents = 'none';
      sludgeLeft--;
      checkRiverClear();
    }

    function checkRiverClear() {
      if (isPlantGrown && isPipeStopped && sludgeLeft === 0) {
        playSound('success');
        document.getElementById('riverTitle').innerText = '죽음의 강(이였던) 태화강';
        document.getElementById('successText').style.display = 'block';
        document.getElementById('brownWater').style.backgroundColor = 'rgba(3, 169, 244, 0.4)';
      }
    }

    // === 5. Screen 3: 몬트리올 의정서 인터랙션 ===
    let acStep = 0; // 0: CFCs, 1: HCFCs, 2: HFCs, 3: HFOs
    function stepAC() {
      playSound('click');
      acStep = (acStep + 1) % 4;
      const tag = document.getElementById('substanceTag');
      const p1 = document.getElementById('p1');
      const p2 = document.getElementById('p2');
      const crack = document.getElementById('ozoneCrack');
      const layer = document.getElementById('ozoneLayer');

      if (acStep === 0) {
        tag.innerText = '현재: 프레온 (CFCs)';
        p1.innerText = p2.innerText = '프레온(CFCs)';
        p1.style.color = p2.style.color = '#00b8d4';
        crack.style.opacity = '1';
        layer.style.borderColor = '#29b6f6';
      } else if (acStep === 1) {
        tag.innerText = '1차 대체: HCFCs';
        p1.innerText = p2.innerText = 'HCFCs';
        p1.style.color = p2.style.color = '#e91e63';
        crack.style.opacity = '0.7';
      } else if (acStep === 2) {
        tag.innerText = '2차 대체: HFCs';
        p1.innerText = p2.innerText = 'HFCs';
        p1.style.color = p2.style.color = '#757575';
        crack.style.opacity = '0.3';
      } else if (acStep === 3) {
        playSound('success');
        tag.innerText = '차세대 대체: HFOs';
        p1.innerText = p2.innerText = 'HFOs';
        p1.style.color = p2.style.color = '#7cb342';
        crack.style.opacity = '0'; // 금 완전 사라짐
        layer.style.borderColor = '#00e676';
      }
    }

    // === Screen 4~10: 미니게임 및 초기화 ===
    let cleanairSmokes = 5;
    function initCleanAir() {
      const box = document.getElementById('cleanairBox');
      cleanairSmokes = 5;
      document.getElementById('smokeCount').innerText = cleanairSmokes;
      document.querySelectorAll('.smoke-item').forEach(e => e.remove());

      for(let i=0; i<5; i++) {
        const smoke = document.createElement('div');
        smoke.className = 'smoke-item interactive-item';
        smoke.innerText = '💨 SO2';
        smoke.style.position = 'absolute';
        smoke.style.top = `${40 + Math.random()*120}px`;
        smoke.style.left = `${20 + Math.random()*60}%`;
        smoke.style.fontWeight = 'bold';
        smoke.style.color = '#d32f2f';
        smoke.onclick = () => {
          playSound('click');
          smoke.remove();
          cleanairSmokes--;
          document.getElementById('smokeCount').innerText = cleanairSmokes;
          if(cleanairSmokes === 0) playSound('success');
        };
        box.appendChild(smoke);
      }
    }

    function useStarfish() {
      playSound('success');
      const road = document.getElementById('iceRoad');
      road.style.background = '#e8f5e9';
      road.style.color = '#2e7d32';
      road.innerText = '🌱 눈이 신속히 녹아 깨끗해진 친환경 도로!';
    }

    function applyBioCoating() {
      playSound('success');
      document.getElementById('foodItem').style.transform = 'scale(1.2)';
      document.getElementById('packageStatus').innerText = '🛡️ 천연 단백질 가스차단막 형성완료 (산소 차단)';
    }

    function decomposePlastic() {
      playSound('success');
      document.getElementById('petBottle').style.opacity = '0.3';
      document.getElementById('chemicalRaw').style.opacity = '1';
      document.getElementById('recycleStatus').innerText = '✨ 미생물 분해로 고가치 기초 화학원료 전환 성공!';
    }

    let liExtracted = 0;
    function extractLi(el) {
      playSound('click');
      el.style.display = 'none';
      liExtracted++;
      document.getElementById('liCountText').innerText = `추출된 리튬: ${liExtracted} / 3`;
      if (liExtracted === 3) playSound('success');
    }

    function captureCO2() {
      playSound('success');
      const cloud = document.getElementById('co2Cloud');
      cloud.style.display = 'none';
      document.getElementById('fuelResult').innerText = '✨ CO2 포집 및 청정 메탄올 연료 전환 완료!';
    }

    // 12. 최종 퀴즈 데이터 및 로직
    const quizData = [
      {
        q: "불가사리 추출 단백질 제설제의 가장 큰 장점은 무엇일까요?",
        opts: ["소금보다 가격이 100배 저렴하다", "도로 부식과 생태계 피해를 최소화한다", "눈이 내리지 않게 막아준다"],
        a: 1
      },
      {
        q: "몬트리올 의정서가 성공적으로 회복시킨 지구의 보호막은?",
        opts: ["오존층", "대류권", "수권"],
        a: 0
      }
    ];
    let currentQuizIdx = 0;

    function loadQuiz() {
      const q = quizData[currentQuizIdx];
      document.getElementById('quizQuestion').innerText = `Q${currentQuizIdx+1}. ${q.q}`;
      const optBox = document.getElementById('quizOptions');
      optBox.innerHTML = '';
      document.getElementById('quizFeedback').innerText = '';

      q.opts.forEach((opt, idx) => {
        const btn = document.createElement('div');
        btn.className = 'quiz-option';
        btn.innerText = `${idx+1}. ${opt}`;
        btn.onclick = () => checkQuiz(idx);
        optBox.appendChild(btn);
      });
    }

    function checkQuiz(selectedIdx) {
      if (selectedIdx === quizData[currentQuizIdx].a) {
        playSound('success');
        document.getElementById('quizFeedback').innerText = "🎉 정답입니다! 기후 비관주의 극복 성공!";
        document.getElementById('quizFeedback').style.color = "#2e7d32";
      } else {
        playSound('click');
        document.getElementById('quizFeedback').innerText = "❌ 다시 생각해보세요!";
        document.getElementById('quizFeedback').style.color = "#d32f2f";
      }
    }

    // 게임 전체 리셋
    function resetAllGames() {
      // Screen 1
      activeAirPolicies.clear();
      document.querySelectorAll('.purple-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('yearSlider').value = 2000;
      updateAirChart();

      // Screen 2
      isPlantGrown = false; isPipeStopped = false; sludgeLeft = 4;
      document.getElementById('riverTitle').innerText = '죽음의 강 태화강';
      document.getElementById('successText').style.display = 'none';
      document.getElementById('brownWater').style.backgroundColor = 'rgba(121, 85, 72, 0.75)';
      document.getElementById('wasteWater').style.display = 'block';
      document.getElementById('plants').innerText = '🌱🌱';
      document.getElementById('plants').style.transform = 'none';
      document.querySelectorAll('.sludge').forEach(s => { s.style.opacity = '1'; s.style.pointerEvents = 'auto'; });

      // Screen 3
      acStep = -1; stepAC();

      // Screen 4
      initCleanAir();

      // Screen 5
      const road = document.getElementById('iceRoad');
      road.style.background = '#ffffff'; road.style.color = '#00838f';
      road.innerText = '❄️ 얼어붙은 도로 (염화칼슘 위험)';

      // Screen 6
      document.getElementById('foodItem').style.transform = 'none';
      document.getElementById('packageStatus').innerText = '공기 노출 상태';

      // Screen 7
      document.getElementById('petBottle').style.opacity = '1';
      document.getElementById('chemicalRaw').style.opacity = '0.3';
      document.getElementById('recycleStatus').innerText = '미생물을 클릭하여 효소 반응 개시';

      // Screen 8
      liExtracted = 0;
      document.getElementById('liCountText').innerText = '추출된 리튬: 0 / 3';
      document.querySelectorAll('#brineTank .interactive-item').forEach(e => e.style.display = 'block');

      // Screen 9
      document.getElementById('co2Cloud').style.display = 'block';
      document.getElementById('fuelResult').innerText = 'DAC 포집기 작동 대기 중';

      // Screen 10
      currentQuizIdx = 0;
      loadQuiz();
    }

    // 초기 실행
    window.onload = () => {
      resetAllGames();
      updateModalText('screen-home');
    };
  </script>
</body>
</html>
